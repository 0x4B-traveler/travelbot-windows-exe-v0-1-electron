  "materials": [
    {
      "key": "guide-昆明",
      "kind": "guide",
      "title": "昆明旅行攻略",
      "city": "昆明",
      "tags": [
        "攻略",
        "示例数据"
      ],
      "body": "四季如春，全年适合出行；冬季早晚温差大，带件外套。长水机场到市区约 40 分钟，地铁 6 号线直达；去石林可坐高铁到石林西站。必吃：过桥米线、汽锅鸡、鲜花饼、野生菌火锅（菌子一定要煮熟）。",
      "images": [
        "images/guide-kunming.jpg"
      ]
    },
    {
      "key": "guide-大理",
      "kind": "guide",
      "title": "大理旅行攻略",
      "city": "大理",
      "tags": [
        "攻略",
        "示例数据"
      ],
      "body": "3—5 月和 9—11 月最舒服；紫外线强，注意防晒。昆明到大理动车约 2 小时；环洱海建议包车或租电动车。必吃：酸辣鱼、乳扇、饵块、喜洲粑粑、雕梅。",
      "images": [
        "images/guide-dali.jpg"
      ]
    },
    {
      "key": "guide-丽江",
      "kind": "guide",
      "title": "丽江旅行攻略",
      "city": "丽江",
      "tags": [
        "攻略",
        "示例数据"
      ],
      "body": "玉龙雪山常年低温，上山带羽绒服；高原反应注意别剧烈运动。大理到丽江动车约 1.5 小时；玉龙雪山需提前在官方渠道预约索道。必吃：腊排骨火锅、鸡豆凉粉、丽江粑粑、纳西烤鱼。",
      "images": [
        "images/guide-lijiang.jpg"
      ]
    },
    {
      "key": "guide-香格里拉",
      "kind": "guide",
      "title": "香格里拉旅行攻略",
      "city": "香格里拉",
      "tags": [
        "攻略",
        "示例数据"
      ],
      "body": "海拔约 3300 米，早晚冷；6—9 月花海最好看，冬季可看雪景。丽江到香格里拉自驾或大巴约 3.5 小时；景点之间建议包车。必吃：牦牛火锅、酥油茶、青稞饼、藏式烤肉。",
      "images": [
        "images/guide-shangrila.jpg"
      ]
    },
    {
      "key": "guide-西双版纳",
      "kind": "guide",
      "title": "西双版纳旅行攻略",
      "city": "西双版纳",
      "tags": [
        "攻略",
        "示例数据"
      ],
      "body": "11 月—次年 4 月干季最适合；夏季多雨闷热，备好驱蚊。嘎洒机场离告庄约 15 分钟；野象谷和植物园可坐动车或包车。必吃：傣味烧烤、菠萝饭、柠檬撒撇、手抓饭。",
      "images": [
        "images/guide-banna.jpg"
      ]
    },
    {
      "key": "guide-腾冲",
      "kind": "guide",
      "title": "腾冲旅行攻略",
      "city": "腾冲",
      "tags": [
        "攻略",
        "示例数据"
      ],
      "body": "秋冬银杏季（11 月中下旬）最热门；全年都适合泡温泉。驼峰机场离市区约 20 分钟；和顺古镇和热海之间打车约 30 分钟。必吃：大救驾（炒饵块）、稀豆粉、土锅子、松花糕。",
      "images": [
        "images/guide-tengchong.jpg"
      ]
    },
