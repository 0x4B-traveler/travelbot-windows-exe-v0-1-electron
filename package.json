{
  "name": "travelbot-windows",
  "version": "0.1.0",
  "description": "TravelBot Windows PoC - WeCom QR authorization and test messaging",
  "main": "dist-electron/electron/main.js",
  "author": "TravelBot",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -p tsconfig.json && vite build && electron-builder --win --x64",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@wecom/cli": "^1.3.2",
    "@wecom/cli-win32-x64": "^1.3.2",
    "@vitejs/plugin-react": "^4.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.travelbot.desktop",
    "productName": "TravelBot",
    "asar": true,
    "files": ["dist", "dist-electron", "package.json", "node_modules/@wecom/cli/**/*", "node_modules/@wecom/cli-win32-x64/**/*"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "artifactName": "TravelBot-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
